<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fondo sólido corporativo -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#031F2E" />
        </shape>
    </item>
    <!-- Márgenes negativos para hacer zoom y eliminar cualquier espacio en blanco o padding transparente -->
    <item android:left="-18dp" android:right="-18dp" android:top="-18dp" android:bottom="-18dp">
        <bitmap
            android:src="@drawable/stocksale_logo"
            android:gravity="fill" />
    </item>
</layer-list>
